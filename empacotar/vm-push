#!/usr/bin/env python3
"""Copia um arquivo ou uma pasta do host para a VM Windows de testes.

Uso:
    ./vm-push arquivo_local  'C:\\caminho\\no\\windows'
    ./vm-push pasta_local/   'C:\\caminho\\no\\windows'
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import vmagente


def main() -> int:
    if len(sys.argv) != 3:
        print(__doc__)
        return 2
    origem, destino = Path(sys.argv[1]), sys.argv[2]
    if not origem.exists():
        print(f"não existe: {origem}", file=sys.stderr)
        return 1

    vmagente.ligar()
    if origem.is_file():
        vmagente.powershell(
            f"New-Item -ItemType Directory -Force -Path "
            f"(Split-Path -Parent '{destino}') | Out-Null")
        n = vmagente.enviar_arquivo(origem, destino)
        print(f"{origem.name}  {n} bytes  ->  {destino}")
    else:
        quantos, bytes_ = vmagente.enviar_pasta(origem, destino)
        print(f"{quantos} arquivos, {bytes_ / 1024:.0f} kB  ->  {destino}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
